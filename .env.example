# LoanLedger demo server configuration
# Copy this file to ".env" and fill in your own values. Never commit ".env".

PORT=3001

# TiDB Cloud / MySQL connection string (keep this secret).
# Note: do NOT point this at the reserved "sys" schema - use a dedicated
# database (e.g. loanledger_demo) that the app user can create tables in.
DATABASE_URL=mysql://USER:PASSWORD@host:4000/loanledger_demo

# Secret used to sign demo authentication tokens.
# Replace with a long random string before any shared/demo deployment.
JWT_SECRET=change-me-to-a-long-random-string-for-this-demo

# Initial admin account bootstrap (created on first server start if missing).
# Do NOT hardcode a production password. Set these via environment variables.
ADMIN_EMAIL=admin@loanledger.demo
ADMIN_PASSWORD=

# If ADMIN_PASSWORD is left empty, a strong random password is generated
# and printed once to the server console on first run.
