# LoanLedger frontend configuration
# Copy this file to ".env". Only VITE_* values are exposed to the browser.

# Backend API base URL. Leave unset when the frontend and API share an origin
# (combined deployment, or Vite dev proxy). For a separate backend deployment:
# VITE_API_URL=https://your-backend.vercel.app/api

# UPI details shown on the simulated checkout screen.
VITE_UPI_VPA=your-upi-id@bank
VITE_UPI_PAYEE=Your Name
