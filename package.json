{
  "name": "loanledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LoanLedger - modern Indian loan website demo (simulated, non-lending)",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev -w backend",
    "dev:client": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "seed": "npm run seed -w backend",
    "refresh": "npm run refresh -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
