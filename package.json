{
  "name": "loanledger-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LoanLedger - modern Indian loan website demo (simulated, non-lending)",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "node server/seed.js",
    "refresh": "node server/scripts/refresh-content.mjs",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.61.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^8.2.2",
    "vite": "^8.3.5"
  }
}
